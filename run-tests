#!/usr/bin/env -S emacs --script

;;; run-tests --- Run ERT test suite for org-docsgen -*- lexical-binding: t; -*-

(require 'seq)
(require 'ert)
(require 'package)

(defconst org-docsgen-test-runner--root
  (file-name-directory (or load-file-name buffer-file-name))
  "Directory this script lives in -- the package root.")

(defconst org-docsgen-test-runner--deps-dir
  (expand-file-name ".deps" org-docsgen-test-runner--root)
  "Directory holding fetched dependencies, gitignored and cached across runs.")

(defconst org-docsgen-test-runner--packages
  '(compat s f xtdlib)
  "Packages fetched via package.el.")

(defun org-docsgen-test-runner--ensure-packages ()
  "Install any missing PACKAGES into `package-user-dir', then load them."
  (setq package-user-dir (expand-file-name "elpa" org-docsgen-test-runner--deps-dir))
  (setq package-archives '(("gnu" . "https://elpa.gnu.org/packages/")
                           ("melpa" . "https://melpa.org/packages/")
                           ("nongnu" . "https://elpa.nongnu.org/nongnu/")
                           ("elpaish" . "https://tychoish.github.io/elpaish/snapshot/")))
  (setq package-check-signature nil)
  (package-initialize)
  ;; Prefer local ../xtdlib if present
  (let ((local-xtdlib (expand-file-name "../xtdlib" org-docsgen-test-runner--root)))
    (when (file-directory-p local-xtdlib)
      (add-to-list 'load-path local-xtdlib)))
  (let ((has-compat (file-expand-wildcards (expand-file-name "compat-*" package-user-dir)))
        (missing (seq-remove #'package-installed-p org-docsgen-test-runner--packages)))
    (when (or missing (not has-compat))
      (package-refresh-contents)
      (unless has-compat
        (let ((compat-desc (cadr (assq 'compat package-archive-contents))))
          (when compat-desc
            (condition-case nil
                (package-install compat-desc)
              (error nil)))))
      (package-initialize)
      (require 'compat nil t)
      (seq-do (lambda (pkg)
                (unless (package-installed-p pkg)
                  (condition-case nil
                      (package-install pkg)
                    (error nil))))
              missing)
      (package-initialize))))

(org-docsgen-test-runner--ensure-packages)

(require 'compat nil t)

(add-to-list 'load-path org-docsgen-test-runner--root)

(seq-do (lambda (file) (load file nil t))
        (directory-files (file-name-concat org-docsgen-test-runner--root "test")
                         t "\\`test-.*\\.el\\'"))

(ert-run-tests-batch-and-exit "^org-docsgen")

;;; run-tests ends here
